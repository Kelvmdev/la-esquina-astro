---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SobreNosotros from "../components/SobreNosotros.astro";
import Menu from "../components/Menu.astro";
import Testimonios from "../components/Testimonios.astro";
import Contacto from "../components/Contacto.astro";
import Galeria from "../components/Galeria.astro";
---

<Layout
  titulo="La Esquina | Restaurante de comida paisa en Medellín"
  descripcion="Restaurante de cocina tradicional con ingredientes locales y un toque moderno. Reserva tu mesa hoy en Medellín."
  preloadHero={true}
>
  <Hero />
  <SobreNosotros />
  <Menu />
  <Galeria />
  <Testimonios />
  <Contacto />
</Layout>