---
import Layout from "../layouts/Layout.astro";
import TarjetaPlato from "../components/TarjetaPlato.astro";
import { menu } from "../config";

// Orden fijo de categorías; se omiten las que no tengan platos
const ORDEN = ["Entradas", "Sopas", "Platos fuertes", "Postres", "Bebidas"];
const categorias = ORDEN
  .map((nombre) => ({ nombre, platos: menu.filter((p) => p.categoria === nombre) }))
  .filter((c) => c.platos.length > 0);
---

<Layout
  titulo="Nuestra carta | La Esquina"
  descripcion="Carta completa de La Esquina: entradas, sopas, platos fuertes, postres y bebidas de la cocina paisa tradicional en Medellín."
>
  <section class="py-20 px-6 bg-stone-100">
    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12">
        <span class="text-amber-700 font-semibold uppercase tracking-wider">Menú completo</span>
        <h1 class="text-4xl md:text-5xl font-bold mt-2">Nuestra carta</h1>
      </div>

      <div class="space-y-16">
        {categorias.map((categoria) => (
          <div>
            <h2 class="text-2xl md:text-3xl font-bold mb-8 border-b-2 border-amber-700 pb-2">
              {categoria.nombre}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {categoria.platos.map((plato) => <TarjetaPlato {...plato} />)}
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-16">
        <a href="/" class="inline-block bg-amber-700 hover:bg-amber-800 text-white px-8 py-4 rounded-lg font-semibold text-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2">
          ← Volver al inicio
        </a>
      </div>

    </div>
  </section>
</Layout>
