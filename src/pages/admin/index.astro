---
export const prerender = false;

import { sitio, menu, testimonios, galeria } from "../../config";
import "../../styles/global.css";

const logueado = Astro.cookies.get("sesion")?.value === "ok";
const error = Astro.url.searchParams.get("error");
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel — La Esquina</title>
  </head>
  <body class="min-h-screen bg-stone-100 p-6">
    {logueado ? (
      <div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold">Panel La Esquina 🍴</h1>
          <a href="/api/logout" class="text-sm text-stone-500 hover:text-stone-700 underline">Cerrar sesión</a>
        </div>

  <!-- Card: info del sitio -->
  <div data-sitio class="bg-white rounded-2xl shadow-lg p-6 md:p-8 space-y-4">
    <h2 class="text-lg font-bold">Información del sitio</h2>

    <label class="block">
      <span class="block text-sm font-medium mb-1">Nombre del restaurante</span>
      <input data-campo="nombre" value={sitio.nombre} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
    <label class="block">
      <span class="block text-sm font-medium mb-1">Título principal (hero)</span>
      <input data-campo="titulo" value={sitio.titulo} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
    <label class="block">
      <span class="block text-sm font-medium mb-1">Subtítulo (hero)</span>
      <input data-campo="subtitulo" value={sitio.subtitulo} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
    <label class="block">
      <span class="block text-sm font-medium mb-1">Dirección</span>
      <input data-campo="direccion" value={sitio.direccion} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
    <label class="block">
      <span class="block text-sm font-medium mb-1">Teléfono</span>
      <input data-campo="telefono" value={sitio.telefono} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
    <label class="block">
      <span class="block text-sm font-medium mb-1">Email</span>
      <input data-campo="email" value={sitio.email} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
    <label class="block">
      <span class="block text-sm font-medium mb-1">Horario</span>
      <input data-campo="horario" value={sitio.horario} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
    </label>
  </div>

  <!-- Card: menú -->
  <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 space-y-4">
    <h2 class="text-lg font-bold">Menú 🍽️</h2>

    <div data-menu-lista class="space-y-4">
      {menu.map((plato, i) => (
        <div data-plato class="border border-stone-200 rounded-xl p-4 space-y-3">
          <div class="flex items-center justify-between">
            <p data-plato-num class="text-sm font-semibold text-amber-700">Plato {i + 1}</p>
            <button type="button" data-borrar class="text-sm text-red-600 hover:text-red-700 font-medium">Borrar</button>
          </div>
          <label class="block">
            <span class="block text-sm font-medium mb-1">Nombre</span>
            <input data-campo="nombre" value={plato.nombre} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
          </label>
          <label class="block">
            <span class="block text-sm font-medium mb-1">Precio</span>
            <input data-campo="precio" value={plato.precio} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
          </label>
          <label class="block">
            <span class="block text-sm font-medium mb-1">Descripción</span>
            <textarea data-campo="descripcion" rows="2" class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700">{plato.descripcion}</textarea>
          </label>
          <div>
            <span class="block text-sm font-medium mb-1">Imagen del plato</span>
            <img data-preview src={plato.imagen} alt={plato.nombre} class="w-32 h-24 object-cover rounded-lg border border-stone-200 mb-2" />
            <input type="file" accept="image/*" data-file class="block w-full text-sm text-stone-600 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-amber-700 file:text-white file:cursor-pointer hover:file:bg-amber-800" />
            <p data-upload hidden class="text-xs mt-1"></p>
            <input type="hidden" data-campo="imagen" value={plato.imagen} />
          </div>
        </div>
      ))}
    </div>

    <button type="button" data-agregar-plato class="w-full border-2 border-dashed border-amber-700 text-amber-700 font-semibold py-2 rounded-lg hover:bg-amber-50 transition">
      + Agregar plato
    </button>
  </div>
 <!-- Card: testimonios -->
  <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 space-y-4">
    <h2 class="text-lg font-bold">Testimonios 💬</h2>

    <div data-testi-lista class="space-y-4">
      {testimonios.map((t, i) => (
        <div data-testi class="border border-stone-200 rounded-xl p-4 space-y-3">
          <div class="flex items-center justify-between">
            <p data-testi-num class="text-sm font-semibold text-amber-700">Testimonio {i + 1}</p>
            <button type="button" data-borrar-testi class="text-sm text-red-600 hover:text-red-700 font-medium">Borrar</button>
          </div>
          <label class="block">
            <span class="block text-sm font-medium mb-1">Texto</span>
            <textarea data-campo="texto" rows="3" class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700">{t.texto}</textarea>
          </label>
          <label class="block">
            <span class="block text-sm font-medium mb-1">Nombre</span>
            <input data-campo="nombre" value={t.nombre} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
          </label>
          <label class="block">
            <span class="block text-sm font-medium mb-1">Rol</span>
            <input data-campo="rol" value={t.rol} class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
          </label>
          <div>
            <span class="block text-sm font-medium mb-1">Avatar</span>
            <img data-preview-avatar src={t.avatar} alt={t.nombre} class="w-16 h-16 object-cover rounded-full border border-stone-200 mb-2" />
            <input type="file" accept="image/*" data-file-avatar class="block w-full text-sm text-stone-600 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-amber-700 file:text-white file:cursor-pointer hover:file:bg-amber-800" />
            <p data-upload-avatar hidden class="text-xs mt-1"></p>
            <input type="hidden" data-campo="avatar" value={t.avatar} />
          </div>
        </div>
      ))}
    </div>

    <button type="button" data-agregar-testi class="w-full border-2 border-dashed border-amber-700 text-amber-700 font-semibold py-2 rounded-lg hover:bg-amber-50 transition">
      + Agregar testimonio
    </button>
  </div>
  <!-- Card: galería -->
  <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8 space-y-4">
    <h2 class="text-lg font-bold">Galería 🖼️</h2>
    <p class="text-sm text-stone-500">Fotos del local que se muestran en la web.</p>

    <div data-galeria-lista class="grid grid-cols-3 gap-3">
      {galeria.map((url) => (
        <div data-foto-item class="relative group">
          <img src={url} class="w-full aspect-square object-cover rounded-lg border border-stone-200" />
          <button type="button" data-borrar-foto class="absolute top-1 right-1 bg-red-600 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center opacity-90 hover:bg-red-700">✕</button>
        </div>
      ))}
    </div>

    <input type="file" accept="image/*" multiple data-file-galeria class="block w-full text-sm text-stone-600 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-amber-700 file:text-white file:cursor-pointer hover:file:bg-amber-800" />
    <p data-upload-galeria hidden class="text-xs"></p>
  </div>

  <!-- Guardar (uno solo, para todo) -->
  <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8">
    <button data-guardar class="w-full bg-amber-700 hover:bg-amber-800 text-white font-semibold py-3 rounded-lg transition disabled:opacity-60">
      Guardar cambios
    </button>
    <p data-estado hidden class="text-sm text-center mt-3"></p>
  </div>
</div>
    ) : (
      <div class="min-h-screen flex items-center justify-center">
        <form method="POST" action="/api/login" class="bg-white rounded-2xl shadow-lg p-8 max-w-md w-full">
          <h1 class="text-2xl font-bold mb-6 text-center">Panel La Esquina 🍴</h1>
          <label class="block text-sm font-medium mb-2">Clave</label>
          <input type="password" name="clave" required class="w-full px-4 py-3 border border-stone-300 rounded-lg mb-4 focus:outline-none focus:border-amber-700" placeholder="••••••••" />
          <button type="submit" class="w-full bg-amber-700 hover:bg-amber-800 text-white font-semibold py-3 rounded-lg transition">Entrar</button>
          {error && <p class="text-red-600 text-sm text-center mt-4">Clave incorrecta, intenta de nuevo.</p>}
        </form>
      </div>
    )}

    <script define:vars={{ sitioActual: sitio, menuActual: menu, testimoniosActual: testimonios }}>
  const btn = document.querySelector("[data-guardar]");
  const estado = document.querySelector("[data-estado]");
  const menuContainer = document.querySelector("[data-menu-lista]");
  const testiContainer = document.querySelector("[data-testi-lista]");
  const galeriaContainer = document.querySelector("[data-galeria-lista]");

  const CLOUD_NAME = "dw26ujhoo";
  const UPLOAD_PRESET = "portafolio_unsigned";

  function avisarError(msg) {
    estado.hidden = false;
    estado.textContent = msg;
    estado.className = "text-sm text-center text-red-700";
  }

  async function subirACloudinary(file) {
    const form = new FormData();
    form.append("file", file);
    form.append("upload_preset", UPLOAD_PRESET);
    const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, { method: "POST", body: form });
    if (!res.ok) throw new Error("Falló la subida");
    const data = await res.json();
    return data.secure_url;
  }

  function renumerarPlatos() {
    menuContainer.querySelectorAll("[data-plato]").forEach((card, i) => {
      const num = card.querySelector("[data-plato-num]");
      if (num) num.textContent = `Plato ${i + 1}`;
    });
  }
  function renumerarTestimonios() {
    testiContainer.querySelectorAll("[data-testi]").forEach((card, i) => {
      const num = card.querySelector("[data-testi-num]");
      if (num) num.textContent = `Testimonio ${i + 1}`;
    });
  }

  // Menú: subir imagen
  menuContainer.addEventListener("change", async (e) => {
    if (!e.target.matches("[data-file]")) return;
    const card = e.target.closest("[data-plato]");
    const file = e.target.files[0];
    if (!file) return;
    const aviso = card.querySelector("[data-upload]");
    const hidden = card.querySelector('[data-campo="imagen"]');
    const preview = card.querySelector("[data-preview]");
    aviso.hidden = false;
    aviso.textContent = "Subiendo imagen…";
    aviso.className = "text-xs mt-1 text-stone-600";
    try {
      const url = await subirACloudinary(file);
      hidden.value = url;
      preview.src = url;
      aviso.textContent = "¡Imagen lista! ✅";
      aviso.className = "text-xs mt-1 text-green-700";
    } catch {
      aviso.textContent = "No se pudo subir. Intenta de nuevo.";
      aviso.className = "text-xs mt-1 text-red-700";
    }
  });

  // Menú: borrar
  menuContainer.addEventListener("click", (e) => {
    if (!e.target.matches("[data-borrar]")) return;
    if (menuContainer.querySelectorAll("[data-plato]").length <= 1) {
      alert("Debe quedar al menos un plato.");
      return;
    }
    e.target.closest("[data-plato]").remove();
    renumerarPlatos();
  });

  // Menú: agregar
  document.querySelector("[data-agregar-plato]")?.addEventListener("click", () => {
    const nuevo = menuContainer.querySelector("[data-plato]").cloneNode(true);
    nuevo.querySelectorAll("[data-campo]").forEach((el) => { el.value = ""; });
    nuevo.querySelector("[data-file]").value = "";
    nuevo.querySelector("[data-preview]").src = "https://placehold.co/300x200?text=Sin+foto";
    const aviso = nuevo.querySelector("[data-upload]");
    aviso.hidden = true;
    aviso.textContent = "";
    menuContainer.appendChild(nuevo);
    renumerarPlatos();
  });

  // Testimonios: subir avatar
  testiContainer.addEventListener("change", async (e) => {
    if (!e.target.matches("[data-file-avatar]")) return;
    const card = e.target.closest("[data-testi]");
    const file = e.target.files[0];
    if (!file) return;
    const aviso = card.querySelector("[data-upload-avatar]");
    const hidden = card.querySelector('[data-campo="avatar"]');
    const preview = card.querySelector("[data-preview-avatar]");
    aviso.hidden = false;
    aviso.textContent = "Subiendo avatar…";
    aviso.className = "text-xs mt-1 text-stone-600";
    try {
      const url = await subirACloudinary(file);
      hidden.value = url;
      preview.src = url;
      aviso.textContent = "¡Avatar listo! ✅";
      aviso.className = "text-xs mt-1 text-green-700";
    } catch {
      aviso.textContent = "No se pudo subir. Intenta de nuevo.";
      aviso.className = "text-xs mt-1 text-red-700";
    }
  });

  // Testimonios: borrar
  testiContainer.addEventListener("click", (e) => {
    if (!e.target.matches("[data-borrar-testi]")) return;
    if (testiContainer.querySelectorAll("[data-testi]").length <= 1) {
      alert("Debe quedar al menos un testimonio.");
      return;
    }
    e.target.closest("[data-testi]").remove();
    renumerarTestimonios();
  });

  // Testimonios: agregar
  document.querySelector("[data-agregar-testi]")?.addEventListener("click", () => {
    const nuevo = testiContainer.querySelector("[data-testi]").cloneNode(true);
    nuevo.querySelectorAll("[data-campo]").forEach((el) => { el.value = ""; });
    const fileAv = nuevo.querySelector("[data-file-avatar]");
    if (fileAv) fileAv.value = "";
    const prevAv = nuevo.querySelector("[data-preview-avatar]");
    if (prevAv) prevAv.src = "https://placehold.co/100x100?text=Avatar";
    const avAviso = nuevo.querySelector("[data-upload-avatar]");
    if (avAviso) { avAviso.hidden = true; avAviso.textContent = ""; }
    testiContainer.appendChild(nuevo);
    renumerarTestimonios();
  });

  // Galería: crear miniatura
  function itemFoto(url) {
    const div = document.createElement("div");
    div.dataset.fotoItem = "";
    div.className = "relative group";
    div.innerHTML = `
      <img src="${url}" class="w-full aspect-square object-cover rounded-lg border border-stone-200" />
      <button type="button" data-borrar-foto class="absolute top-1 right-1 bg-red-600 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center opacity-90 hover:bg-red-700">✕</button>
    `;
    return div;
  }

  // Galería: subir varias
  const fileGaleria = document.querySelector("[data-file-galeria]");
  const avisoGaleria = document.querySelector("[data-upload-galeria]");
  fileGaleria?.addEventListener("change", async () => {
    const files = Array.from(fileGaleria.files || []);
    if (files.length === 0) return;
    avisoGaleria.hidden = false;
    let subidas = 0;
    for (const file of files) {
      avisoGaleria.textContent = `Subiendo ${subidas + 1} de ${files.length}…`;
      avisoGaleria.className = "text-xs text-stone-600";
      try {
        const url = await subirACloudinary(file);
        galeriaContainer.appendChild(itemFoto(url));
        subidas++;
      } catch {}
    }
    avisoGaleria.textContent = subidas === files.length
      ? `✅ ${subidas} foto(s) agregada(s)`
      : `⚠️ Subidas ${subidas} de ${files.length}`;
    avisoGaleria.className = "text-xs text-green-700";
    fileGaleria.value = "";
  });

  // Galería: borrar foto
  galeriaContainer.addEventListener("click", (e) => {
    if (!e.target.matches("[data-borrar-foto]")) return;
    e.target.closest("[data-foto-item]").remove();
  });

  // Guardar
  btn?.addEventListener("click", async () => {
    const sitio = { ...sitioActual };
    document.querySelectorAll("[data-sitio] [data-campo]").forEach((el) => {
      sitio[el.dataset.campo] = el.value;
    });

    const menu = [];
    menuContainer.querySelectorAll("[data-plato]").forEach((card) => {
      const plato = {};
      card.querySelectorAll("[data-campo]").forEach((el) => { plato[el.dataset.campo] = el.value; });
      menu.push(plato);
    });

    const testimonios = [];
    testiContainer.querySelectorAll("[data-testi]").forEach((card) => {
      const t = {};
      card.querySelectorAll("[data-campo]").forEach((el) => { t[el.dataset.campo] = el.value; });
      testimonios.push(t);
    });

    const galeria = Array.from(galeriaContainer.querySelectorAll("[data-foto-item] img")).map((img) => img.src);

    // --- Validación mínima (#6) ---
    if (!sitio.nombre.trim()) return avisarError("⚠️ El nombre del restaurante no puede estar vacío.");
    if (menu.some((p) => !p.nombre.trim() || !p.precio.trim())) return avisarError("⚠️ Hay un plato sin nombre o sin precio.");
    if (testimonios.some((t) => !t.texto.trim() || !t.nombre.trim())) return avisarError("⚠️ Hay un testimonio sin texto o sin nombre.");

    const nuevaData = { sitio, menu, testimonios, galeria };

    estado.hidden = false;
    estado.textContent = "Guardando…";
    estado.className = "text-sm text-center text-stone-600";
    btn.disabled = true;
    try {
      const res = await fetch("/api/guardar", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(nuevaData),
      });
      if (res.ok) {
        estado.textContent = "¡Guardado! La web se actualizará en ~1 min. 🎉";
        estado.className = "text-sm text-center text-green-700";
      } else {
        estado.textContent = "Algo falló al guardar. Intenta de nuevo.";
        estado.className = "text-sm text-center text-red-700";
      }
    } catch {
      estado.textContent = "No pudimos conectar. Revisa tu red.";
      estado.className = "text-sm text-center text-red-700";
    } finally {
      btn.disabled = false;
    }
  });
</script>
  </body>
</html>