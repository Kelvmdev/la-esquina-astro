---
import '../styles/global.css';
import { sitio, heroSrcset } from '../config';
import Navbar from '../components/Navbar.astro';

const {
  titulo,
  descripcion,
  imagen,
  imagenAlt = 'La Esquina — Restaurante de comida paisa en Medellín',
  // Solo la home precarga su imagen hero (es el elemento LCP de esa página)
  preloadHero = false,
} = Astro.props;

const base = Astro.site ?? Astro.url;

// Enlaces de contacto del footer (derivados de los datos del sitio)
const telLimpio = sitio.telefono?.replace(/[^\d+]/g, "") ?? "";
const waUrl = sitio.whatsapp ? `https://wa.me/${sitio.whatsapp}` : "";
const redes = sitio.redes ?? {};

// URL canónica de la página actual (respeta el `site` de astro.config)
const canonical = new URL(Astro.url.pathname, base).href;

// OG/Twitter por defecto: imagen de marca propia (1200×630). Las páginas pueden
// pasar `imagen` para sobreescribirla. Siempre se emite como URL absoluta.
const ogImagen = new URL(imagen ?? '/og.png', base).href;

// Datos estructurados para negocio local (Google → resultados enriquecidos).
// Para el schema usamos una foto real del restaurante, no la tarjeta de marca.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: sitio.nombre,
  description: descripcion,
  image: new URL(sitio.heroImagen, base).href,
  url: canonical,
  telephone: sitio.telefono,
  email: sitio.email,
  servesCuisine: 'Comida paisa, cocina colombiana tradicional',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: sitio.direccion,
    addressLocality: 'Medellín',
    addressCountry: 'CO',
  },
  openingHours: 'Mo-Su 12:00-23:00',
};
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#b45309" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <!-- Acelera la carga de imágenes externas (LCP) -->
    <link rel="preconnect" href="https://images.pexels.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    {preloadHero && (
      <link
        rel="preload"
        as="image"
        href={sitio.heroImagen}
        imagesrcset={heroSrcset(sitio.heroImagen) || undefined}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imagenAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={sitio.nombre} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={ogImagen} />
    <meta name="twitter:image:alt" content={imagenAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-amber-700 focus:px-4 focus:py-2 focus:font-semibold focus:text-white focus:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
    >
      Saltar al contenido
    </a>
    <Navbar />
    <main id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <footer class="bg-stone-900 text-stone-300 mt-20">
      <div class="max-w-6xl mx-auto px-6 py-12 grid gap-10 md:grid-cols-3">

        <!-- Marca + redes -->
        <div>
          <div class="text-2xl font-bold text-white">
            <span aria-hidden="true">🍴</span> {sitio.nombre}
          </div>
          <p class="mt-3 text-sm leading-relaxed">{sitio.subtitulo}</p>

          <div class="mt-5 flex gap-3">
            {redes.instagram && (
              <a href={redes.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram de La Esquina"
                 class="text-stone-300 hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm0 2h10c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3zm5 3a5 5 0 100 10 5 5 0 000-10zm0 2a3 3 0 110 6 3 3 0 010-6zm4.5-2.8a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z"/></svg>
              </a>
            )}
            {redes.facebook && (
              <a href={redes.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook de La Esquina"
                 class="text-stone-300 hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"/></svg>
              </a>
            )}
            {waUrl && (
              <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp de La Esquina"
                 class="text-stone-300 hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.15h-.01a8.2 8.2 0 01-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.21 8.21 0 01-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 012.41 5.82c0 4.54-3.69 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
              </a>
            )}
          </div>
        </div>

        <!-- Contacto -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-amber-500">Contacto</h2>
          <ul class="mt-4 space-y-2 text-sm">
            <li>{sitio.direccion}</li>
            <li>{sitio.horario}</li>
            <li>
              <a href={`tel:${telLimpio}`} class="hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">{sitio.telefono}</a>
            </li>
            <li>
              <a href={`mailto:${sitio.email}`} class="hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">{sitio.email}</a>
            </li>
          </ul>
        </div>

        <!-- Enlaces rápidos -->
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-amber-500">Enlaces</h2>
          <ul class="mt-4 space-y-2 text-sm">
            <li><a href="/#inicio" class="hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">Inicio</a></li>
            <li><a href="/menu" class="hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">Menú</a></li>
            <li><a href="/#contacto" class="hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">Contacto</a></li>
          </ul>
        </div>

      </div>

      <div class="border-t border-stone-800">
        <div class="max-w-6xl mx-auto px-6 py-5 text-xs text-stone-400 text-center">
          © 2026 {sitio.nombre}. Todos los derechos reservados. ·
          <span>Sitio por <a href="https://mi-portafolio-eta-hazel.vercel.app" target="_blank" rel="noopener noreferrer" class="underline hover:text-amber-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900">Kervin Martínez</a></span>
        </div>
      </div>
    </footer>
  </body>
</html>
