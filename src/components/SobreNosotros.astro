---
import { sobre } from "../config";
---

<section id="sobre" class="py-20 px-6">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <div>
      <img
        src={sobre.imagen}
        alt="Interior acogedor de La Esquina con mesas servidas"
        width="800"
        height="533"
        loading="lazy"
        decoding="async"
        class="rounded-2xl shadow-2xl w-full">
    </div>
    <div>
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Sobre nosotros</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2 mb-6">
        Una historia de pasión por la cocina
      </h2>
      {sobre.historia.map((parrafo, i) => (
        <p class={`text-stone-600 text-lg ${i === sobre.historia.length - 1 ? "mb-8" : "mb-4"} leading-relaxed`}>
          {parrafo}
        </p>
      ))}
      <div class="grid grid-cols-3 gap-4">
        {sobre.stats.map((stat) => (
          <div class="text-center">
            <div class="text-4xl font-bold text-amber-700">{stat.numero}</div>
            <div class="text-stone-600 text-sm mt-1">{stat.etiqueta}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>