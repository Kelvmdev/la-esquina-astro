---
import { testimonios } from "../config";
---

<section id="testimonios" class="py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Opiniones</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">Lo que dicen nuestros clientes</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonios.map((t) => (
        <div class="bg-white p-8 rounded-2xl shadow-lg">
          <div class="text-amber-500 text-2xl mb-4">★★★★★</div>
          <p class="text-stone-700 italic mb-6">"{t.texto}"</p>
          <div class="flex items-center gap-4">
            <img src={t.avatar} alt={`Foto de ${t.nombre}`} width="48" height="48" loading="lazy" decoding="async" class="w-12 h-12 rounded-full" />
            <div>
              <div class="font-bold">{t.nombre}</div>
              <div class="text-stone-500 text-sm">{t.rol}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>