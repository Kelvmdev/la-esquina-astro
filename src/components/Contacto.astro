---
---

<section id="contacto" class="py-20 px-6 bg-stone-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Reservas</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">¿Listo para una experiencia única?</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-bold mb-6">Visítanos</h3>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="text-3xl">📍</div>
            <div>
              <div class="font-bold">Dirección</div>
              <p class="text-stone-600">Calle 70 #45-12, El Poblado, Medellín</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="text-3xl">📞</div>
            <div>
              <div class="font-bold">Teléfono</div>
              <p class="text-stone-600">+57 300 123 4567</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="text-3xl">✉️</div>
            <div>
              <div class="font-bold">Email</div>
              <p class="text-stone-600">hola@laesquina.com</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="text-3xl">🕐</div>
            <div>
              <div class="font-bold">Horario</div>
              <p class="text-stone-600">Lunes a Domingo: 12:00 PM - 11:00 PM</p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-lg">
        <h3 class="text-2xl font-bold mb-6">Reserva tu mesa</h3>
        <form class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-2">Nombre completo</label>
            <input type="text" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" placeholder="Tu nombre" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Email</label>
            <input type="email" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" placeholder="tu@email.com" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-2">Fecha</label>
              <input type="date" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Personas</label>
              <select class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700">
                <option>2 personas</option>
                <option>4 personas</option>
                <option>6 personas</option>
                <option>8 personas</option>
              </select>
            </div>
          </div>
          <button type="submit" class="w-full bg-amber-700 hover:bg-amber-800 text-white font-semibold py-3 rounded-lg transition mt-4">
            Confirmar reserva
          </button>
        </form>
      </div>
    </div>
  </div>
</section>