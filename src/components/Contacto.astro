---
import Mapa from "./Mapa.astro";
import { sitio } from "../config";

const telLimpio = sitio.telefono?.replace(/[^\d+]/g, "") ?? "";
const waUrl = sitio.whatsapp ? `https://wa.me/${sitio.whatsapp}` : "";
---

<section id="contacto" class="py-20 px-6 bg-stone-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Reservas</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">¿Listo para una experiencia única?</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-bold mb-6">Visítanos</h3>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="text-3xl" aria-hidden="true">📍</div>
            <div>
              <div class="font-bold">Dirección</div>
              <p class="text-stone-600">{sitio.direccion}</p>
            </div>
          </div>

          <Mapa alto="h-64" />

          <div class="flex items-start gap-4">
            <div class="text-3xl" aria-hidden="true">📞</div>
            <div>
              <div class="font-bold">Teléfono</div>
              <a href={`tel:${telLimpio}`} class="text-stone-600 hover:text-amber-700 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2">{sitio.telefono}</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="text-3xl" aria-hidden="true">✉️</div>
            <div>
              <div class="font-bold">Email</div>
              <a href={`mailto:${sitio.email}`} class="text-stone-600 hover:text-amber-700 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2">{sitio.email}</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="text-3xl" aria-hidden="true">🕐</div>
            <div>
              <div class="font-bold">Horario</div>
              <p class="text-stone-600">{sitio.horario}</p>
            </div>
          </div>

          {waUrl && (
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full bg-amber-700 hover:bg-amber-800 text-white font-semibold py-3 rounded-lg transition focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2"
            >
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.15h-.01a8.2 8.2 0 01-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.21 8.21 0 01-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 012.41 5.82c0 4.54-3.69 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
              Reservar por WhatsApp
            </a>
          )}

        </div>
      </div>
      <div class="bg-white p-8 rounded-2xl shadow-lg">
        <h3 class="text-2xl font-bold mb-6">Reserva tu mesa</h3>
        <form id="form-reserva" class="space-y-4">
          <input type="hidden" name="_subject" value="Nueva reserva — La Esquina" />
          <div>
            <label for="nombre" class="block text-sm font-medium mb-2">Nombre completo</label>
            <input id="nombre" type="text" name="nombre" autocomplete="name" required class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700 focus-visible:ring-2 focus-visible:ring-amber-700" placeholder="Tu nombre" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-2">Email</label>
            <input id="email" type="email" name="email" autocomplete="email" required class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700 focus-visible:ring-2 focus-visible:ring-amber-700" placeholder="tu@email.com" />
          </div>
          <div>
            <label for="telefono" class="block text-sm font-medium mb-2">Teléfono</label>
            <input id="telefono" type="tel" name="telefono" autocomplete="tel" required class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700 focus-visible:ring-2 focus-visible:ring-amber-700" placeholder="+57 300 123 4567" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="fecha" class="block text-sm font-medium mb-2">Fecha</label>
              <input id="fecha" type="date" name="fecha" required class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700 focus-visible:ring-2 focus-visible:ring-amber-700" />
            </div>
            <div>
              <label for="personas" class="block text-sm font-medium mb-2">Personas</label>
              <select id="personas" name="personas" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700 focus-visible:ring-2 focus-visible:ring-amber-700">
                <option>2 personas</option>
                <option>4 personas</option>
                <option>6 personas</option>
                <option>8 personas</option>
              </select>
            </div>
          </div>
          <div>
            <label for="nota" class="block text-sm font-medium mb-2">Nota (opcional)</label>
            <textarea id="nota" name="nota" rows="3" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:outline-none focus:border-amber-700 focus-visible:ring-2 focus-visible:ring-amber-700 resize-none" placeholder="¿Algo especial? Cumpleaños, alergias, mesa en terraza…"></textarea>
          </div>
          <button type="submit" class="w-full bg-amber-700 hover:bg-amber-800 text-white font-semibold py-3 rounded-lg transition mt-4 disabled:opacity-60 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2">
            <span data-btn-label>Confirmar reserva</span>
            <span data-btn-spinner hidden>Enviando…</span>
          </button>
          <p data-form-status role="status" aria-live="polite" hidden class="text-sm text-center"></p>
        </form>
      </div>
    </div>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>("#form-reserva");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const label = form?.querySelector<HTMLElement>("[data-btn-label]");
  const spinner = form?.querySelector<HTMLElement>("[data-btn-spinner]");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  // No permitir reservar en el pasado: min = hoy (fecha local del visitante)
  const fechaInput = form?.querySelector<HTMLInputElement>("#fecha");
  if (fechaInput) {
    const ahora = new Date();
    fechaInput.min = new Date(ahora.getTime() - ahora.getTimezoneOffset() * 60000)
      .toISOString()
      .split("T")[0];
  }

  const setStatus = (msg: string, ok: boolean) => {
    if (!status) return;
    status.textContent = msg;
    status.hidden = false;
    status.className = `text-sm text-center ${ok ? "text-green-700" : "text-red-700"}`;
  };

  const setLoading = (loading: boolean) => {
    if (button) button.disabled = loading;
    if (label) label.hidden = loading;
    if (spinner) spinner.hidden = !loading;
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    setLoading(true);
    if (status) status.hidden = true;

    try {
      const res = await fetch("https://formspree.io/f/xbdbvjgk", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      if (res.ok) {
        setStatus("¡Gracias! Recibimos tu reserva. 🎉", true);
        form.reset();
      } else {
        setStatus("Ups, algo falló. Intenta de nuevo.", false);
      }
    } catch {
      setStatus("No pudimos enviar. Revisa tu conexión.", false);
    } finally {
      setLoading(false);
    }
  });
</script>