---
import TarjetaPlato from "./TarjetaPlato.astro";
import { menu } from "../config";

const platos = menu;
---

<section id="menu" class="py-20 px-6 bg-stone-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Nuestro menú</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">Platos que enamoran</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {platos.map((plato) => <TarjetaPlato {...plato} />)}
    </div>
  </div>
</section>