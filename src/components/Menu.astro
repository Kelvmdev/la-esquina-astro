---
import TarjetaPlato from "./TarjetaPlato.astro";

const platos = [
  { nombre: "Bandeja Paisa", precio: "$35.000", descripcion: "Frijoles, arroz, carne molida, chicharrón, chorizo, huevo, arepa, plátano y aguacate.", imagen: "https://commons.wikimedia.org/wiki/Special:FilePath/Bandeja%20paisa%2030062011.jpg?width=800" },
  { nombre: "Sancocho Antioqueño", precio: "$28.000", descripcion: "Sopa de carnes con yuca, plátano y mazorca, al estilo de la casa.", imagen: "https://images.pexels.com/photos/32334852/pexels-photo-32334852.jpeg?auto=compress&cs=tinysrgb&w=800" },
  { nombre: "Mondongo", precio: "$26.000", descripcion: "Tradicional sopa de mondongo con verduras y un toque de cilantro.", imagen: "https://images.pexels.com/photos/15780649/pexels-photo-15780649.jpeg?auto=compress&cs=tinysrgb&w=800" },
  { nombre: "Frijoles Antioqueños", precio: "$22.000", descripcion: "Frijoles con garra, arroz blanco, chicharrón y arepa.", imagen: "https://images.pexels.com/photos/31985804/pexels-photo-31985804.jpeg?auto=compress&cs=tinysrgb&w=800" },
  { nombre: "Arepa de Chócolo", precio: "$12.000", descripcion: "Arepa dulce de maíz tierno servida con quesito fresco.", imagen: "https://images.pexels.com/photos/33173598/pexels-photo-33173598.jpeg?auto=compress&cs=tinysrgb&w=800" },
  { nombre: "Mazamorra con Panela", precio: "$8.000", descripcion: "Postre paisa de maíz con leche, acompañado de panela.", imagen: "https://images.pexels.com/photos/37825034/pexels-photo-37825034.jpeg?auto=compress&cs=tinysrgb&w=800" },
];
---

<section id="menu" class="py-20 px-6 bg-stone-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Nuestro menú</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">Platos que enamoran</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {platos.map((plato) => <TarjetaPlato {...plato} />)}
    </div>
  </div>
</section>