---
import TarjetaPlato from "./TarjetaPlato.astro";

const platos = [
  { nombre: "Pizza Margherita", precio: "$15", descripcion: "Tomate, mozzarella fresca y albahaca de nuestro jardín.", imagen: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?w=600" },
  { nombre: "Ensalada César", precio: "$12", descripcion: "Lechuga romana, parmesano, crutones y nuestro aderezo casero.", imagen: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600" },
  { nombre: "Pasta Carbonara", precio: "$18", descripcion: "Spaghetti con panceta, huevo y queso pecorino romano.", imagen: "https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=600" },
  { nombre: "Burger Premium", precio: "$16", descripcion: "Carne angus 200g, queso cheddar, tocineta y vegetales frescos.", imagen: "https://images.unsplash.com/photo-1546833999-b9f581a1996d?w=600" },
  { nombre: "Pollo a la Parrilla", precio: "$20", descripcion: "Pechuga marinada, papas rústicas y vegetales asados.", imagen: "https://images.unsplash.com/photo-1551782450-a2132b4ba21d?w=600" },
  { nombre: "Tiramisú Clásico", precio: "$8", descripcion: "Postre italiano con café, mascarpone y cacao.", imagen: "https://images.unsplash.com/photo-1565299543923-37dd37887442?w=600" },
];
---

<section id="menu" class="py-20 px-6 bg-stone-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Nuestro menú</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">Platos que enamoran</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {platos.map((plato) => <TarjetaPlato {...plato} />)}
    </div>
  </div>
</section>