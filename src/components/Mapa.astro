---
interface Props {
  lat: number;
  lon: number;
  zoom?: number;
  lang?: string;
  alto?: string;
}

const { lat, lon, zoom = 16, lang = "es", alto = "h-72" } = Astro.props;

const mapSrc = `https://maps.google.com/maps?q=${lat},${lon}&z=${zoom}&hl=${lang}&output=embed`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`;
---

<div data-mapa class={`relative w-full overflow-hidden rounded-2xl shadow-lg ${alto}`}>
  <iframe
    src={mapSrc}
    title="Mapa · La Esquina"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="absolute inset-0 w-full h-full border-0"
  ></iframe>

  <div
    data-mapa-overlay
    aria-hidden="true"
    class="absolute inset-0 flex items-center justify-center cursor-pointer"
  >
    <span
      data-mapa-hint
      hidden
      class="pointer-events-none px-3 py-1.5 rounded-full bg-black/85 text-white text-xs shadow-lg"
    >
      Doble clic para interactuar
    </span>
  </div>

  <a
    href={mapHref}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute bottom-3 left-3 z-10 bg-white text-stone-900 text-sm px-4 py-2 rounded-full shadow-lg font-semibold hover:bg-stone-100 transition"
  >
    📍 Cómo llegar
  </a>
</div>

<script>
  const section = document.querySelector<HTMLElement>("[data-mapa]");
  const overlay = section?.querySelector<HTMLElement>("[data-mapa-overlay]");
  const hint = overlay?.querySelector<HTMLElement>("[data-mapa-hint]");

  if (section && overlay) {
    let tapCount = 0;
    let tapTimer: number | undefined;

    const lock = () => {
      overlay.style.pointerEvents = "";
      tapCount = 0;
      if (hint) hint.hidden = true;
      if (tapTimer) { clearTimeout(tapTimer); tapTimer = undefined; }
    };

    const unlock = () => {
      overlay.style.pointerEvents = "none";
      tapCount = 0;
      if (hint) hint.hidden = true;
    };

    overlay.addEventListener("click", () => {
      tapCount++;
      if (tapCount === 1) {
        if (hint) hint.hidden = false;
        if (tapTimer) clearTimeout(tapTimer);
        tapTimer = setTimeout(() => { tapCount = 0; if (hint) hint.hidden = true; }, 1800);
      } else {
        unlock();
      }
    });

    section.addEventListener("wheel", () => {
      if (overlay.style.pointerEvents === "none") lock();
    }, { passive: true });
  }
</script>