---
import { galeria } from '../config';
const fotos = galeria;
---

<section id="galeria" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-amber-700 font-semibold uppercase tracking-wider">Galería</span>
      <h2 class="text-4xl md:text-5xl font-bold mt-2">Un vistazo a La Esquina</h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {fotos.map((foto, i) => (
        <button data-foto={i} aria-label={`Ampliar foto ${i + 1} de La Esquina`} class="group overflow-hidden rounded-xl aspect-[4/3] cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-700 focus-visible:ring-offset-2">
          <img src={foto} alt={`Foto ${i + 1} de La Esquina`} width="600" height="450" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox (visor) -->
  <div data-lightbox role="dialog" aria-modal="true" aria-label="Visor de galería" class="hidden fixed inset-0 z-[60] bg-black/90 items-center justify-center p-4">
    <button data-lb-close aria-label="Cerrar" class="absolute top-4 right-6 text-white text-4xl leading-none cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-white">✕</button>
    <button data-lb-prev aria-label="Anterior" class="absolute left-4 text-white text-5xl leading-none px-2 cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-white">‹</button>
    <img data-lb-img src="" alt="Foto ampliada" class="max-h-[85vh] max-w-[90vw] object-contain rounded-lg" />
    <button data-lb-next aria-label="Siguiente" class="absolute right-4 text-white text-5xl leading-none px-2 cursor-pointer rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-white">›</button>
    <span data-lb-counter class="absolute bottom-6 text-white text-sm"></span>
  </div>
</section>

<script>
  const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
  const lbImg = lightbox?.querySelector<HTMLImageElement>("[data-lb-img]");
  const lbCounter = lightbox?.querySelector<HTMLElement>("[data-lb-counter]");
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>("[data-lb-close]");
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-foto]"));
  const srcs = triggers.map((t) => t.querySelector<HTMLImageElement>("img")?.src ?? "");

  let current = 0;
  let lastFocused: HTMLElement | null = null; // thumbnail que abrió el visor

  const estaAbierto = () => !!lightbox && !lightbox.classList.contains("hidden");

  const render = (i: number) => {
    current = (i + srcs.length) % srcs.length;
    if (lbImg) lbImg.src = srcs[current];
    if (lbCounter) lbCounter.textContent = `${current + 1} / ${srcs.length}`;
  };

  // Inertiza/restaura todo lo que no sea el visor (fondo no accesible a foco ni a lectores)
  const inertizarFondo = (activar: boolean) => {
    if (!lightbox) return;
    Array.from(document.body.children).forEach((el) => {
      if (el === lightbox) return;
      if (activar) {
        el.setAttribute("inert", "");
        el.setAttribute("aria-hidden", "true");
        (el as HTMLElement).dataset.lbInerted = "1";
      } else if ((el as HTMLElement).dataset.lbInerted) {
        el.removeAttribute("inert");
        el.removeAttribute("aria-hidden");
        delete (el as HTMLElement).dataset.lbInerted;
      }
    });
  };

  const open = (i: number, trigger: HTMLElement) => {
    if (!lightbox) return;
    lastFocused = trigger;
    render(i);
    // Mover el visor a nivel de <body> para poder inertizar el resto de la página
    document.body.appendChild(lightbox);
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    inertizarFondo(true);
    closeBtn?.focus(); // mueve el foco al visor
  };

  const close = () => {
    if (!lightbox) return;
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
    inertizarFondo(false);
    lastFocused?.focus(); // restaura el foco al thumbnail de origen
  };

  triggers.forEach((t, i) => t.addEventListener("click", () => open(i, t)));
  closeBtn?.addEventListener("click", close);
  lightbox?.querySelector("[data-lb-prev]")?.addEventListener("click", () => render(current - 1));
  lightbox?.querySelector("[data-lb-next]")?.addEventListener("click", () => render(current + 1));
  lightbox?.addEventListener("click", (e) => { if (e.target === lightbox) close(); });

  document.addEventListener("keydown", (e) => {
    if (!estaAbierto() || !lightbox) return;

    if (e.key === "Escape") { close(); return; }
    if (e.key === "ArrowLeft") { render(current - 1); return; }
    if (e.key === "ArrowRight") { render(current + 1); return; }

    // Trampa de foco: Tab/Shift+Tab ciclan solo dentro del visor
    if (e.key === "Tab") {
      const focusables = Array.from(lightbox.querySelectorAll<HTMLElement>("button"));
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const activo = document.activeElement;
      if (e.shiftKey) {
        if (activo === first || !lightbox.contains(activo)) { e.preventDefault(); last.focus(); }
      } else {
        if (activo === last || !lightbox.contains(activo)) { e.preventDefault(); first.focus(); }
      }
    }
  });
</script>